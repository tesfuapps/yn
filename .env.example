# ─────────────────────────────────────────────
#  Yene Lottery Bot — Environment Variables
# ─────────────────────────────────────────────

# ── Telegram Bot ──
BOT_TOKEN=your_bot_token_here
ADMIN_GROUP_ID=-100xxxxxxxxxx          # admin group/channel for payment screenshots
PUBLIC_GROUP_ID=-100xxxxxxxxxx         # public group for winner announcements
SUPER_ADMIN_IDS=123456789,987654321    # comma-separated user IDs
SUPER_ADMIN_USERNAMES=admin1,admin2    # comma-separated usernames (no @)

# ── Database ──
# SQLite is the default (file: yene_lottery.db) — zero setup required.
# For PostgreSQL, set DATABASE_URL or the DB_* fields below.
#
# Option 1: Direct DSN
# DATABASE_URL=postgresql://postgres:password@localhost:5432/yene_lottery
#
# Option 2: Individual fields (used when DATABASE_URL is empty and DB_HOST is set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yene_lottery
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ── Flask (optional, if web dashboard is enabled) ──
# FLASK_API_URL=http://localhost:5000   # auto-derived if empty
# FLASK_SECRET_KEY=change-me-to-random-string
# FLASK_ADMIN_USERNAME=admin
# FLASK_ADMIN_PASSWORD=change-me

# ── Supabase Storage (optional) ──
# SUPABASE_STORAGE_URL=https://your-project.supabase.co
# SUPABASE_STORAGE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=lottery-uploads

# ── Misc ──
DEBUG=False                             # set to True in production
